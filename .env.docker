# WeatherGPT Docker Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM Provider Configuration
# =============================================================================
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-20b
LLM_PRIMARY_API_KEY=your-groq-api-key-here

LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_SECONDARY_MODEL=gemini-2.0-flash
LLM_SECONDARY_API_KEY=your-gemini-api-key-here

LLM_FALLBACK_BASE_URL=http://ollama:11434/v1
LLM_FALLBACK_MODEL=llama3.2:1b

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default - easiest for demo)
DATABASE_URL=sqlite:////app/data/weathergpt.db

# PostgreSQL (uncomment to use, and enable postgres service in docker-compose.yml)
# DATABASE_URL=postgresql://weathergpt:weathergpt_password@postgres:5432/weathergpt
# POSTGRES_PASSWORD=weathergpt_password

# Redis (optional)
# REDIS_URL=redis://redis:6379

# =============================================================================
# API Configuration
# =============================================================================
API_SECRET_KEY=weathergpt-secret-key-please-change-in-production
API_DEBUG=false

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# Voice Features
# =============================================================================
STT_PROVIDER=groq
TTS_PROVIDER=web

# =============================================================================
# SMS Alerts (Optional)
# =============================================================================
SMS_ENABLED=false
SMS_PROVIDER=mock

# Twilio Configuration (if using SMS)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS Configuration (alternative)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
