# WeatherGPT Environment Configuration
# Copy this file to .env and customize your keys

# =============================================================================
# Zero-Config Shared Team LLM API Keys (Two-Tier Fallback)
# =============================================================================
# Tier 1: Primary (Groq API - Fast inference)
# Get free API key from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
LLM_PRIMARY_API_KEY=your-groq-api-key-here
LLM_PRIMARY_MODEL=llama-3.3-70b-versatile
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1

# Tier 2: Secondary Fallback (Google Gemini API - High Reliability)
# Get free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
LLM_SECONDARY_API_KEY=your-gemini-api-key-here
LLM_SECONDARY_MODEL=gemini-2.0-flash
LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default for local & hackathon demo):
DATABASE_URL=sqlite:///./weathergpt.db

# =============================================================================
# API Security & Fair-Use Rate Limiting
# =============================================================================
API_SECRET_KEY=weathergpt-super-secret-key-change-in-production
API_DEBUG=true
MAX_QUESTIONS_PER_DAY=20

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
