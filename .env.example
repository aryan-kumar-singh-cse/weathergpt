# WeatherGPT Environment Configuration
# Copy this file to .env and customize the values

# =============================================================================
# LLM Provider Configuration (Two-tier fallback)
# =============================================================================
# Users provide their own free API keys at first login
# Keys are encrypted and stored per user email in the database

# Tier 1: Primary (Groq - free, fast)
# Get free API key from: https://console.groq.com
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-20b
LLM_PRIMARY_API_KEY=your-groq-api-key-here

# Tier 2: Secondary Fallback (Gemini - free, reliable)
# Get free API key from: https://aistudio.google.com/app/apikey
LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_SECONDARY_MODEL=gemini-2.0-flash
LLM_SECONDARY_API_KEY=your-gemini-api-key-here

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://weathergpt:weathergpt_password@postgres:5432/weathergpt
REDIS_URL=redis://redis:6379

# =============================================================================
# API Security
# =============================================================================
API_SECRET_KEY=your-super-secret-key-change-in-production
API_DEBUG=true

# Rate Limiting Configuration
# Maximum number of questions per user per 24-hour rolling window
MAX_QUESTIONS_PER_DAY=50

# =============================================================================
# Frontend Configuration
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# =============================================================================
# Voice Service Configuration (Rural Accessibility)
# =============================================================================
# Speech-to-Text Provider (groq, whisper, web)
STT_PROVIDER=groq

# Text-to-Speech Provider (web, openai, groq)
TTS_PROVIDER=web

# Optional: OpenAI API key for premium TTS (if TTS_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# =============================================================================
# Optional: Weather Data Sources
# =============================================================================
# Open-Meteo is used by default (no key required)
# Additional sources can be configured here if needed

# =============================================================================
# Notes:
# 1. Users provide their own free API keys at first login
# 2. Keys are stored encrypted in the database, tied to user email
# 3. System automatically falls back from Groq → Gemini on failure
# 4. Both APIs have generous free tiers suitable for demos/hackathons
# 5. Admin keys here are for system-level operations only (optional)
# 6. Never commit .env to git - use .env.example as template
# =============================================================================
